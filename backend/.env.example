# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/slingshot

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for OTP verification)
# Using Gmail API with OAuth 2.0 (works on Render without SMTP)
# Follow the setup instructions in the project README to generate these credentials

# OAuth 2.0 Credentials from Google Cloud Console
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REFRESH_TOKEN=your_google_refresh_token_here

# Your Gmail address (must match the OAuth consent screen configuration)
GMAIL_SENDER=slingshotchhattisgarh@gmail.com

# Legacy SMTP configuration (no longer used - kept for reference only)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_APP_PASSWORD=your-app-password

# CORS Configuration
# For local development: http://localhost:3000
# For production: https://sling-shot-jade.vercel.app
FRONTEND_URL=https://sling-shot-jade.vercel.app
