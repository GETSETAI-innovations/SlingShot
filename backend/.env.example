# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/slingshot

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for OTP verification)
# Using Resend API (recommended for production deployment on Render)
# Get your API key from https://resend.com/api-keys
EMAIL_API_KEY=re_your_resend_api_key_here
# Sender email must be verified in Resend dashboard
EMAIL_FROM=slingshotchhattisgarh@gmail.com

# Legacy SMTP configuration (no longer used - kept for reference only)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_APP_PASSWORD=your-app-password

# CORS Configuration
# For local development: http://localhost:3000
# For production: https://sling-shot-jade.vercel.app
FRONTEND_URL=https://sling-shot-jade.vercel.app
